# ==============================================================================
# JURISAI — Environment Configuration
# Free / Local-First Defaults
# Paid external APIs (OpenAI, Anthropic, AWS, etc.) are strictly OPTIONAL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=jurisai-local-development-secret-key-change-in-production-min-32-chars
APP_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database
# Local SQLite default (zero external services needed):
DATABASE_URL=sqlite+aiosqlite:///./jurisai.db
# PostgreSQL with pgvector (for Docker Compose):
# DATABASE_URL=postgresql+asyncpg://jurisai:jurisai_password@localhost:5432/jurisai_db

# Local Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage
QUARANTINE_STORAGE_PATH=./data/storage/quarantine
VERIFIED_STORAGE_PATH=./data/storage/verified
REPORTS_STORAGE_PATH=./data/storage/reports

# Optional S3 / MinIO Storage (if STORAGE_BACKEND=s3)
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=jurisai-documents
# S3_REGION=us-east-1

# Redis / Cache (Optional: defaults to in-memory cache)
# REDIS_URL=redis://localhost:6379/0

# Email / SMTP (Local Mailpit by default)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=no-reply@jurisai.com
# Open Mailpit web UI at http://localhost:8025 to view sent emails

# Local AI / LLM Configuration
# Ollama runs 100% locally with zero cloud API keys:
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# If Ollama is not installed or running, JURISAI automatically falls back
# to its intelligent built-in heuristic legal reasoning engine!

# Embeddings Configuration
EMBEDDING_PROVIDER=local
# Local 384-dimensional vector embeddings with cosine similarity:
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Security & Sessions
SESSION_MAX_AGE_SECONDS=86400
SESSION_COOKIE_NAME=jurisai_session
CSRF_COOKIE_NAME=jurisai_csrf
ENFORCE_CSRF=true
SCAN_MAX_FILE_SIZE_MB=50

# ==============================================================================
# OPTIONAL Cloud Providers (Not required for core demo or local operation)
# Leave blank to run 100% free and locally.
# ==============================================================================
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
